{% comment %}
  ------------------------------------------------------------------
  Bundle Builder — Pure Bowl
  ------------------------------------------------------------------
  Standalone Online Store 2.0 section. Customers build a bundle from
  up to 5 merchant-picked meals with quantity steppers.

  Rules mirrored by this section (pricing itself is handled by a
  Shopify automatic discount configured in admin — this section never
  modifies prices):
    - total < minimum (default 4): add to cart blocked
    - minimum..threshold-1 (default 4-9): allowed, tracker counts down
    - total >= threshold (default 10): allowed, discount unlocked

  No external libraries. All JS is scoped per section instance and
  re-initializes on shopify:section:load for the theme editor.
  ------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = section.id

  comment
    Resolve static placeholders once in Liquid. [count] is live and is
    handled by JS; [min] and [percent] never change at runtime.
  endcomment
  assign min_string = s.min_packs | append: ''
  assign percent_string = s.discount_percent | append: ''
  assign min_message_resolved = s.min_message | replace: '[min]', min_string
  assign idle_resolved = s.idle_text | replace: '[percent]', percent_string

  case s.image_ratio
    when 'portrait'
      assign media_ratio = '3 / 4'
    when 'landscape'
      assign media_ratio = '4 / 3'
    else
      assign media_ratio = '1 / 1'
  endcase
-%}

{% style %}
  /* ---- Per-instance design tokens (scoped by section id) ---- */
  #BundleBuilder-{{ sid }} {
    --bb-bg: {{ s.bg_color }};
    --bb-text: {{ s.text_color }};
    --bb-accent: {{ s.accent_color }};
    --bb-accent-soft: {{ s.accent_color | color_modify: 'alpha', 0.14 }};
    --bb-button-bg: {{ s.button_bg }};
    --bb-button-text: {{ s.button_text }};
    --bb-card-bg: {{ s.card_bg }};
    --bb-progress: {{ s.progress_color }};
    --bb-line: {{ s.text_color | color_modify: 'alpha', 0.15 }};
    --bb-line-soft: {{ s.text_color | color_modify: 'alpha', 0.08 }};
    --bb-radius: {{ s.card_radius }}px;
    --bb-heading-size: {{ s.heading_size }}px;
    --bb-body-size: {{ s.body_size }}px;
    --bb-ratio: {{ media_ratio }};
    --bb-cols: {{ s.columns_desktop }};
    --bb-cols-m: {{ s.columns_mobile }};

    background-color: var(--bb-bg);
    color: var(--bb-text);
    padding-top: {{ s.padding_top }}px;
    padding-bottom: {{ s.padding_bottom }}px;
    font-size: var(--bb-body-size);
    line-height: 1.5;
  }

  #BundleBuilder-{{ sid }} .bb-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ---- Header ---- */
  #BundleBuilder-{{ sid }} .bb-header {
    text-align: center;
    margin-bottom: 32px;
  }
  #BundleBuilder-{{ sid }} .bb-heading {
    margin: 0 0 8px;
    font-size: var(--bb-heading-size);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: inherit;
  }
  #BundleBuilder-{{ sid }} .bb-subheading {
    margin: 0 auto;
    max-width: 52ch;
    opacity: 0.75;
  }

  /* ---- Meal grid ---- */
  #BundleBuilder-{{ sid }} .bb-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--bb-cols-m), minmax(0, 1fr));
    gap: 12px;
  }

  #BundleBuilder-{{ sid }} .bb-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px 10px 14px;
    background-color: var(--bb-card-bg);
    border-radius: var(--bb-radius);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    {%- if s.card_border %}
    border: 1px solid var(--bb-line);
    {%- endif %}
  }

  #BundleBuilder-{{ sid }} .bb-card__media {
    position: relative;
    aspect-ratio: var(--bb-ratio);
    border-radius: max(calc(var(--bb-radius) - 6px), 0px);
    overflow: hidden;
    background-color: var(--bb-line-soft);
  }
  #BundleBuilder-{{ sid }} .bb-card__media img,
  #BundleBuilder-{{ sid }} .bb-card__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #BundleBuilder-{{ sid }} .bb-card--unavailable .bb-card__media img {
    filter: grayscale(1);
    opacity: 0.55;
  }

  #BundleBuilder-{{ sid }} .bb-card__badge,
  #BundleBuilder-{{ sid }} .bb-card__flag {
    position: absolute;
    top: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    max-width: calc(100% - 20px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  #BundleBuilder-{{ sid }} .bb-card__badge {
    left: 10px;
    background-color: var(--bb-accent);
    color: var(--bb-button-text);
  }
  #BundleBuilder-{{ sid }} .bb-card__flag {
    right: 10px;
    background-color: {{ s.text_color | color_modify: 'alpha', 0.75 }};
    color: var(--bb-card-bg);
  }

  #BundleBuilder-{{ sid }} .bb-card__info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 4px;
  }
  #BundleBuilder-{{ sid }} .bb-card__title {
    margin: 0;
    font-size: calc(var(--bb-body-size) + 1px);
    font-weight: 600;
    line-height: 1.3;
    color: inherit;
  }
  #BundleBuilder-{{ sid }} .bb-card__price {
    margin: 0;
    font-size: calc(var(--bb-body-size) - 1px);
    opacity: 0.7;
  }

  /* ---- Quantity stepper (44px touch targets) ---- */
  #BundleBuilder-{{ sid }} .bb-stepper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 4px;
    padding: 3px;
    border: 1px solid var(--bb-line);
    border-radius: 999px;
  }
  #BundleBuilder-{{ sid }} .bb-stepper__btn {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--bb-accent);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  #BundleBuilder-{{ sid }} .bb-stepper__btn:hover:not([disabled]) {
    background-color: var(--bb-accent-soft);
  }
  #BundleBuilder-{{ sid }} .bb-stepper__btn[disabled] {
    opacity: 0.35;
    cursor: default;
  }
  #BundleBuilder-{{ sid }} .bb-stepper__qty {
    flex: 1 1 auto;
    min-width: 2ch;
    width: 100%;
    border: 0;
    background: transparent;
    text-align: center;
    font-size: calc(var(--bb-body-size) + 2px);
    font-weight: 600;
    color: inherit;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  #BundleBuilder-{{ sid }} .bb-stepper__qty::-webkit-outer-spin-button,
  #BundleBuilder-{{ sid }} .bb-stepper__qty::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  #BundleBuilder-{{ sid }} .bb-stepper__btn:focus-visible,
  #BundleBuilder-{{ sid }} .bb-stepper__qty:focus-visible,
  #BundleBuilder-{{ sid }} .bb-submit:focus-visible {
    outline: 2px solid var(--bb-accent);
    outline-offset: 2px;
  }

  /* ---- Summary row: tracker + subtotal + button ---- */
  #BundleBuilder-{{ sid }} .bb-summary {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 28px;
  }

  /* The tracker is the emotional center: give it card weight, and let
     the live count sit larger, in the accent color. */
  #BundleBuilder-{{ sid }} .bb-tracker {
    padding: 14px 18px;
    background-color: var(--bb-card-bg);
    border: 1px solid var(--bb-line);
    border-radius: var(--bb-radius);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  #BundleBuilder-{{ sid }} .bb-tracker__text {
    margin: 0;
    font-weight: 500;
    /* Reserve one line of space so an empty idle state causes no layout shift */
    min-height: 1.6em;
    transition: color 0.2s ease;
  }
  #BundleBuilder-{{ sid }} .bb-tracker__count {
    color: var(--bb-accent);
    font-size: 1.3em;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  /* Unlocked state: subtle 200ms transition, no motion effects */
  #BundleBuilder-{{ sid }} .bb-tracker--unlocked {
    background-color: var(--bb-accent-soft);
    border-color: transparent;
  }
  #BundleBuilder-{{ sid }} .bb-tracker--unlocked .bb-tracker__text {
    color: var(--bb-accent);
    font-weight: 600;
  }

  #BundleBuilder-{{ sid }} .bb-progress {
    height: 6px;
    margin-top: 10px;
    border-radius: 999px;
    background-color: var(--bb-line-soft);
    overflow: hidden;
  }
  #BundleBuilder-{{ sid }} .bb-progress__fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background-color: var(--bb-progress);
    transition: width 0.2s ease;
  }

  #BundleBuilder-{{ sid }} .bb-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #BundleBuilder-{{ sid }} .bb-subtotal {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
    font-size: calc(var(--bb-body-size) - 1px);
    opacity: 0.8;
  }
  #BundleBuilder-{{ sid }} .bb-subtotal__value {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  #BundleBuilder-{{ sid }} .bb-submit {
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: 999px;
    background-color: var(--bb-button-bg);
    color: var(--bb-button-text);
    font-size: calc(var(--bb-body-size) + 1px);
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: opacity 0.15s ease, filter 0.15s ease;
  }
  #BundleBuilder-{{ sid }} .bb-submit:hover:not([disabled]) {
    filter: brightness(1.06);
  }
  #BundleBuilder-{{ sid }} .bb-submit[disabled] {
    opacity: 0.55;
    cursor: default;
  }
  /* Loading and success keep full strength so they read as activity, not blocked */
  #BundleBuilder-{{ sid }} .bb-submit--busy[disabled],
  #BundleBuilder-{{ sid }} .bb-submit--success[disabled] {
    opacity: 1;
  }

  #BundleBuilder-{{ sid }} .bb-error {
    margin: 0;
    color: #b3261e;
    font-size: calc(var(--bb-body-size) - 1px);
  }

  #BundleBuilder-{{ sid }} .bb-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 749px) {
    /* Sticky summary at the bottom of the section (not fixed to the
       viewport): the CTA stays reachable while adjusting quantities and
       releases once the section scrolls past. */
    #BundleBuilder-{{ sid }} .bb-summary {
      position: sticky;
      bottom: 0;
      z-index: 2;
      margin-top: 20px;
      padding: 12px 0 16px;
      background-color: var(--bb-bg);
      box-shadow: 0 -10px 18px -14px rgba(0, 0, 0, 0.25);
    }
    #BundleBuilder-{{ sid }} .bb-submit {
      width: 100%;
    }
  }

  @media (min-width: 750px) {
    #BundleBuilder-{{ sid }} .bb-container {
      padding: 0 40px;
    }
    #BundleBuilder-{{ sid }} .bb-grid {
      grid-template-columns: repeat(var(--bb-cols), minmax(0, 1fr));
      gap: 20px;
    }
    #BundleBuilder-{{ sid }} .bb-summary {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
    #BundleBuilder-{{ sid }} .bb-tracker {
      flex: 1 1 auto;
    }
    #BundleBuilder-{{ sid }} .bb-actions {
      flex: 0 0 auto;
      min-width: 300px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #BundleBuilder-{{ sid }} .bb-tracker,
    #BundleBuilder-{{ sid }} .bb-tracker__text,
    #BundleBuilder-{{ sid }} .bb-progress__fill,
    #BundleBuilder-{{ sid }} .bb-stepper__btn,
    #BundleBuilder-{{ sid }} .bb-submit {
      transition: none;
    }
  }
{% endstyle %}

<div id="BundleBuilder-{{ sid }}" class="bb-root" data-bundle-builder>
  <div class="bb-container">
    {%- if s.heading != blank or s.subheading != blank -%}
      <div class="bb-header">
        {%- if s.heading != blank -%}
          <h2 class="bb-heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="bb-subheading">{{ s.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="bb-grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign has_product = false
          if product != blank
            assign has_product = true
          endif

          comment
            Purchasable means the product has at least one available
            variant; we always add the first available variant.
          endcomment
          assign purchasable = false
          if has_product and product.available
            assign purchasable = true
            assign variant = product.first_available_variant
          endif

          assign meal_title = block.settings.custom_label
          if meal_title == blank and has_product
            assign meal_title = product.title
          endif
          if meal_title == blank
            assign meal_title = 'No product selected'
          endif

          assign qty_id = 'BBQty-' | append: sid | append: '-' | append: forloop.index
        -%}

        <li class="bb-card{% unless purchasable %} bb-card--unavailable{% endunless %}" {{ block.shopify_attributes }}>
          <div class="bb-card__media">
            {%- if block.settings.badge != blank -%}
              <span class="bb-card__badge">{{ block.settings.badge | escape }}</span>
            {%- endif -%}
            {%- if has_product and purchasable == false -%}
              <span class="bb-card__flag">Sold out</span>
            {%- endif -%}
            {%- if has_product and product.featured_image -%}
              {{ product.featured_image | image_url: width: 800 | image_tag: widths: '360, 540, 720', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>

          <div class="bb-card__info">
            <h3 class="bb-card__title">{{ meal_title | escape }}</h3>
            {%- if s.show_price and purchasable -%}
              <p class="bb-card__price">{{ variant.price | money }}</p>
            {%- endif -%}
          </div>

          {%- if purchasable -%}
            <div
              class="bb-stepper"
              data-meal-row
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              data-max="{{ s.per_meal_max }}"
            >
              <button type="button" class="bb-stepper__btn" data-step-down aria-label="Decrease quantity of {{ meal_title | escape }}" disabled>
                <span aria-hidden="true">&minus;</span>
              </button>
              <label class="bb-visually-hidden" for="{{ qty_id }}">Quantity of {{ meal_title | escape }}</label>
              <input
                id="{{ qty_id }}"
                class="bb-stepper__qty"
                data-qty-input
                type="number"
                inputmode="numeric"
                min="0"
                max="{{ s.per_meal_max }}"
                step="1"
                value="0"
              >
              <button type="button" class="bb-stepper__btn" data-step-up aria-label="Increase quantity of {{ meal_title | escape }}">
                <span aria-hidden="true">+</span>
              </button>
            </div>
          {%- else -%}
            {%- comment -%} Sold out or no product yet: steppers rendered but disabled {%- endcomment -%}
            <div class="bb-stepper" data-meal-row data-unavailable>
              <button type="button" class="bb-stepper__btn" aria-label="Decrease quantity of {{ meal_title | escape }}" disabled>
                <span aria-hidden="true">&minus;</span>
              </button>
              <label class="bb-visually-hidden" for="{{ qty_id }}">Quantity of {{ meal_title | escape }}</label>
              <input id="{{ qty_id }}" class="bb-stepper__qty" type="number" value="0" disabled>
              <button type="button" class="bb-stepper__btn" aria-label="Increase quantity of {{ meal_title | escape }}" disabled>
                <span aria-hidden="true">+</span>
              </button>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    <div class="bb-summary">
      <div class="bb-tracker" data-tracker>
        <p class="bb-tracker__text" data-tracker-text aria-live="polite" aria-atomic="true">{{ idle_resolved | escape }}</p>
        {%- if s.show_progress -%}
          <div class="bb-progress" aria-hidden="true">
            <span class="bb-progress__fill" data-progress-fill style="width: 0%"></span>
          </div>
        {%- endif -%}
      </div>

      <div class="bb-actions">
        {%- if s.show_subtotal -%}
          <p class="bb-subtotal">
            <span>{{ s.subtotal_label | escape }}</span>
            <span class="bb-subtotal__value" data-subtotal-value>{{ 0 | money }}</span>
          </p>
        {%- endif -%}
        <button type="button" class="bb-submit" data-add-button disabled>
          <span data-button-label>{{ min_message_resolved | escape }}</span>
        </button>
        <p class="bb-error" data-error aria-live="polite" hidden></p>
      </div>
    </div>
  </div>

  <script type="application/json" data-bundle-config>
    {
      "minPacks": {{ s.min_packs }},
      "threshold": {{ s.discount_threshold }},
      "percent": {{ s.discount_percent }},
      "afterAdd": {{ s.after_add | json }},
      "trackerText": {{ s.tracker_text | json }},
      "unlockedText": {{ s.unlocked_text | json }},
      "idleText": {{ s.idle_text | json }},
      "minMessage": {{ s.min_message | json }},
      "buttonLabel": {{ s.button_label | json }},
      "loadingLabel": {{ s.loading_label | json }},
      "successLabel": {{ s.success_label | json }},
      "errorMessage": {{ s.error_message | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "cartAddUrl": {{ routes.cart_add_url | json }},
      "cartUrl": {{ routes.cart_url | json }}
    }
  </script>
</div>

<script>
  (function () {
    'use strict';

    function initBundleBuilder(root) {
      /* Guard against double initialization (inline run + section:load) */
      if (!root || root.dataset.bbInit === 'true') return;
      root.dataset.bbInit = 'true';

      var configEl = root.querySelector('[data-bundle-config]');
      if (!configEl) return;
      var config = JSON.parse(configEl.textContent);

      /* Resolve merchant placeholders that never change at runtime.
         [count] stays live and is swapped in on every render. */
      var minMessage = config.minMessage.split('[min]').join(config.minPacks);
      var trackerTemplate = config.trackerText.split('[percent]').join(config.percent);
      var unlockedText = config.unlockedText.split('[percent]').join(config.percent);
      var idleText = (config.idleText || '').split('[percent]').join(config.percent);

      var rows = Array.prototype.slice.call(
        root.querySelectorAll('[data-meal-row]:not([data-unavailable])')
      );
      var trackerEl = root.querySelector('[data-tracker]');
      var trackerTextEl = root.querySelector('[data-tracker-text]');
      var progressFill = root.querySelector('[data-progress-fill]');
      var button = root.querySelector('[data-add-button]');
      var buttonLabel = root.querySelector('[data-button-label]');
      var errorEl = root.querySelector('[data-error]');
      var subtotalEl = root.querySelector('[data-subtotal-value]');

      var busy = false; /* true while a cart request or success state owns the button */
      var successTimer = null;

      function clamp(value, max) {
        var n = parseInt(value, 10);
        if (isNaN(n) || n < 0) n = 0;
        return Math.min(n, max);
      }

      function rowMax(row) {
        return parseInt(row.dataset.max, 10) || 0;
      }

      function rowQty(row) {
        return clamp(row.querySelector('[data-qty-input]').value, rowMax(row));
      }

      function totals() {
        var count = 0;
        var cents = 0;
        rows.forEach(function (row) {
          var qty = rowQty(row);
          count += qty;
          cents += qty * (parseInt(row.dataset.price, 10) || 0);
        });
        return { count: count, cents: cents };
      }

      /* Mirrors the shop money format Liquid renders with; covers its
         common placeholders. Used only for the pre-discount subtotal —
         discounted pricing is never computed here. */
      function formatMoney(cents) {
        var value = (cents / 100).toFixed(2);
        var parts = value.split('.');
        var grouped = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        var groupedEu = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        var map = {
          amount: grouped + '.' + parts[1],
          amount_no_decimals: grouped,
          amount_with_comma_separator: groupedEu + ',' + parts[1],
          amount_no_decimals_with_comma_separator: groupedEu
        };
        return config.moneyFormat.replace(/\{\{\s*(\w+)\s*\}\}/, function (match, key) {
          return map[key] || map.amount;
        });
      }

      /* Writes the tracker template into the live region, rendering the
         [count] placeholder as an accented number without injecting HTML */
      function setTrackerCountdown(remaining) {
        trackerTextEl.textContent = '';
        var parts = trackerTemplate.split('[count]');
        parts.forEach(function (part, i) {
          trackerTextEl.appendChild(document.createTextNode(part));
          if (i < parts.length - 1) {
            var num = document.createElement('span');
            num.className = 'bb-tracker__count';
            num.textContent = remaining;
            trackerTextEl.appendChild(num);
          }
        });
      }

      function hideError() {
        errorEl.hidden = true;
        errorEl.textContent = '';
      }

      function render() {
        var t = totals();

        /* Per-row stepper limits: minus disabled at 0, plus at the max */
        rows.forEach(function (row) {
          var qty = rowQty(row);
          row.querySelector('[data-step-down]').disabled = qty <= 0;
          row.querySelector('[data-step-up]').disabled = qty >= rowMax(row);
        });

        /* ----------------------------------------------------------
         * State boundaries
         *   total < minPacks (default 4)   -> BLOCKED: button disabled,
         *                                     minimum-not-met message
         *   minPacks..threshold-1 (4-9)    -> ALLOWED: tracker counts
         *                                     down to the discount
         *   total >= threshold (default 10)-> ALLOWED: discount unlocked
         * (The countdown itself runs from 1 pack, across the blocked/
         *  allowed boundary, per the tracker rules.)
         * ---------------------------------------------------------- */
        if (t.count === 0) {
          trackerEl.classList.remove('bb-tracker--unlocked');
          trackerTextEl.textContent = idleText;
        } else if (t.count < config.threshold) {
          trackerEl.classList.remove('bb-tracker--unlocked');
          setTrackerCountdown(config.threshold - t.count);
        } else {
          trackerEl.classList.add('bb-tracker--unlocked');
          trackerTextEl.textContent = unlockedText;
        }

        if (progressFill) {
          /* Progress = total / threshold, capped at 100% */
          progressFill.style.width = Math.min(100, (t.count / config.threshold) * 100) + '%';
        }

        if (subtotalEl) {
          subtotalEl.textContent = formatMoney(t.cents);
        }

        /* While a request or success flash owns the button, leave it alone */
        if (!busy) {
          if (t.count < config.minPacks) {
            button.disabled = true;
            buttonLabel.textContent = minMessage;
          } else {
            button.disabled = false;
            buttonLabel.textContent = config.buttonLabel;
          }
        }
      }

      function setQty(row, value) {
        var input = row.querySelector('[data-qty-input]');
        input.value = clamp(value, rowMax(row));
        hideError();
        render();
      }

      function showSuccess() {
        buttonLabel.textContent = config.successLabel;
        button.classList.remove('bb-submit--busy');
        button.classList.add('bb-submit--success');
        button.removeAttribute('aria-busy');
        /* Reset quantities to zero; render() skips the button while busy */
        rows.forEach(function (row) {
          row.querySelector('[data-qty-input]').value = 0;
        });
        render();
        successTimer = setTimeout(function () {
          busy = false;
          button.classList.remove('bb-submit--success');
          render();
        }, 2000);
      }

      function failRequest() {
        busy = false;
        button.classList.remove('bb-submit--busy');
        button.removeAttribute('aria-busy');
        errorEl.textContent = config.errorMessage;
        errorEl.hidden = false;
        render(); /* re-enables the button; it is never left stuck loading */
      }

      function addToCart() {
        var t = totals();
        if (busy || t.count < config.minPacks) return;

        var items = rows
          .map(function (row) {
            return { id: parseInt(row.dataset.variantId, 10), quantity: rowQty(row) };
          })
          .filter(function (item) {
            return item.quantity > 0;
          });
        if (items.length === 0) return;

        busy = true;
        clearTimeout(successTimer);
        hideError();
        button.disabled = true;
        button.classList.add('bb-submit--busy');
        button.setAttribute('aria-busy', 'true');
        buttonLabel.textContent = config.loadingLabel;

        /* If the theme ships a Dawn-style cart drawer, request its
           re-rendered sections in the same call so we can open it
           instead of redirecting. Falls back to /cart on any failure. */
        var drawer = document.querySelector('cart-drawer');
        var useDrawer =
          config.afterAdd === 'cart' && drawer && typeof drawer.renderContents === 'function';

        var payload = { items: items };
        if (useDrawer) {
          payload.sections = ['cart-drawer', 'cart-icon-bubble'];
          payload.sections_url = window.location.pathname;
        }

        fetch(config.cartAddUrl + '.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        })
          .then(function (response) {
            return response.json().then(function (data) {
              /* add.js returns a "status" field on errors */
              if (!response.ok || data.status) throw new Error('Cart add failed');
              return data;
            });
          })
          .then(function (data) {
            if (config.afterAdd === 'cart') {
              if (useDrawer) {
                try {
                  drawer.renderContents(data);
                  showSuccess();
                } catch (err) {
                  window.location.href = config.cartUrl;
                }
              } else {
                window.location.href = config.cartUrl;
              }
            } else {
              /* Stay on page: brief success flash, quantities reset */
              showSuccess();
            }
          })
          .catch(function () {
            failRequest();
          });
      }

      /* ---- Events ---- */
      rows.forEach(function (row) {
        var input = row.querySelector('[data-qty-input]');
        row.querySelector('[data-step-down]').addEventListener('click', function () {
          setQty(row, rowQty(row) - 1);
        });
        row.querySelector('[data-step-up]').addEventListener('click', function () {
          setQty(row, rowQty(row) + 1);
        });
        /* Direct keyboard input: recalculate as they type, clamp on commit */
        input.addEventListener('input', function () {
          hideError();
          render();
        });
        input.addEventListener('change', function () {
          setQty(row, input.value);
        });
      });
      button.addEventListener('click', addToCart);

      render();
    }

    /* Register the theme editor hook once per page; each section
       instance initializes itself by id, so two instances never conflict */
    if (!window.__pureBowlBundleBuilderReady) {
      window.__pureBowlBundleBuilderReady = true;
      document.addEventListener('shopify:section:load', function (event) {
        var el = event.target.querySelector('[data-bundle-builder]');
        if (el) initBundleBuilder(el);
      });
    }
    initBundleBuilder(document.getElementById('BundleBuilder-{{ sid }}'));
  })();
</script>

