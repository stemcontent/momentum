      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    },
    {
      "type": "product_list",
      "id": "fallback_products",
      "label": "Manual fallback products",
      "limit": 8,
      "info": "Shown when no complementary products are curated for this product yet."
