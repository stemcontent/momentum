{% comment %}
  ------------------------------------------------------------------
  About Hero — full-viewport typographic statement
  ------------------------------------------------------------------
  No background photo: the serif statement IS the hero. Two richtext
  segments flow as one sentence. When the merchant picks an inline
  image it sits between them at a height that is a multiple of the
  line height, so the text wraps around it; with no image chosen the
  segments simply close up and nothing is drawn in its place.

  Animation layers:
    1. Load (one-shot, first paint): words sweep up + fade with a
       fast stagger (< 1.2s total), then the inline image reveals
       with an upward clip-path wipe. Skipped under reduced motion.
    2. Scroll (linked, reversible): the statement drifts up slightly
       slower than the page; illustration blocks drift at their own
       per-block parallax rates.

  Progressive enhancement: the hidden start state exists only inside
  CSS keyframes gated behind the .ah-anim class, which JS adds. If JS
  never runs, everything renders in its final state; and because the
  entrance is a keyframe animation with fill-mode "both" rather than a
  class-toggled transition, it still completes on wall-clock time in a
  background tab or hidden preview iframe where requestAnimationFrame
  is never serviced. All CSS is scoped by section id; safe for
  multiple instances; re-initializes on shopify:section:load.
  ------------------------------------------------------------------
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign sid = section.id

  comment
    Image shape: rectangle uses the corner-radius slider (0 = sharp),
    rounded is a full pill, arch is fully rounded top corners only.
  endcomment
  case s.image_shape
    when 'arch'
      assign img_radius = '999px 999px 0 0'
    when 'rounded'
      assign img_radius = '999px'
    else
      assign img_radius = s.image_radius | append: 'px'
  endcase

  case s.section_height
    when 'auto'
      assign min_h = ''
    else
      assign min_h = s.section_height
  endcase

  if s.button_direction == 'right'
    assign btn_dir = 'reverse'
  else
    assign btn_dir = 'normal'
  endif

  comment
    Richtext outputs block-level <p> tags; convert them to spans so
    both segments and the inline image flow as a single sentence.
  endcomment
  assign before_html = s.text_before | replace: '<p>', '<span class="ah-p">' | replace: '</p>', '</span> '
  assign after_html = s.text_after | replace: '<p>', '<span class="ah-p">' | replace: '</p>', '</span> '
  assign before_plain = s.text_before | strip_html
  assign after_plain = s.text_after | strip_html
  assign plain_label = before_plain | append: ' ' | append: after_plain | strip
-%}

{% style %}
  /* ---- Own the box model inside this section so padding is
         contained by declared heights and widths, whatever the
         host theme's global default happens to be ---- */
  #AboutHero-{{ sid }},
  #AboutHero-{{ sid }} *,
  #AboutHero-{{ sid }} *::before,
  #AboutHero-{{ sid }} *::after {
    box-sizing: border-box;
  }

  /* ---- Per-instance design tokens (every setting becomes a custom
         property on the section root) ---- */
  #AboutHero-{{ sid }} {
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ah-bg: {{ s.color_bg }};
    --ah-ink: {{ s.color_text }};
    --ah-muted: {{ s.color_label }};
    --ah-btn-ink: {{ s.button_color }};
    --ah-size-min: {{ s.size_min }}px;
    --ah-size-max: {{ s.size_max }}px;
    --ah-size-fluid: {{ s.size_vw }}vw;
    --ah-lh: {{ s.line_height | divided_by: 100.0 }};
    --ah-maxw: {{ s.statement_max }}ch;
    --ah-img-scale: {{ s.image_scale | divided_by: 100.0 }};
    --ah-img-radius: {{ img_radius }};
    --ah-btn-speed: {{ s.button_speed }}s;
    --ah-btn-dir: {{ btn_dir }};
    --ah-parallax: {{ s.parallax_strength }};

    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    {% if min_h != '' %}
    min-height: {{ min_h }}vh;
    min-height: {{ min_h }}svh;
    {% endif %}
    padding-top: {{ s.pad_top }}px;
    padding-bottom: {{ s.pad_bottom }}px;
    background-color: var(--ah-bg);
    color: var(--ah-ink);
  }

  /* ---- Statement ---- */
  #AboutHero-{{ sid }} .ah-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    /* Scroll parallax: drifts down relative to the document so the
       statement appears to rise slightly slower than the page */
    transform: translate3d(0, var(--ah-drift, 0px), 0);
  }

  #AboutHero-{{ sid }} .ah-label {
    display: block;
    margin: 0 0 30px;
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--ah-muted);
  }

  #AboutHero-{{ sid }} .ah-statement {
    margin: 0 auto;
    max-width: var(--ah-maxw);
    font-family: var(--font-heading-family, Georgia, 'Times New Roman', serif);
    font-weight: 400;
    font-size: clamp(var(--ah-size-min), var(--ah-size-fluid), var(--ah-size-max));
    line-height: var(--ah-lh);
    letter-spacing: -0.01em;
    text-wrap: balance;
    color: var(--ah-ink);
  }

  /* ---- Inline image within the sentence ---- */
  #AboutHero-{{ sid }} .ah-media {
    display: inline-block;
    vertical-align: middle;
    height: calc(1em * var(--ah-lh) * var(--ah-img-scale));
    aspect-ratio: var(--ah-img-ar, 0.78);
    margin: 0 0.18em;
    border-radius: var(--ah-img-radius);
    overflow: hidden;
  }
  #AboutHero-{{ sid }} .ah-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---- Marquee button (shared pattern: static centered label; on
         hover/focus a duplicated track loops seamlessly) ---- */
  #AboutHero-{{ sid }} .ah-btnrow {
    margin-top: 44px;
  }
  #AboutHero-{{ sid }} .ah-btn {
    position: relative;
    display: inline-block;
    overflow: hidden;
    padding: 15px 36px;
    border: 1px solid var(--ah-btn-ink);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ah-btn-ink);
  }
  #AboutHero-{{ sid }} .ah-btn:focus-visible {
    outline: 1px solid var(--ah-btn-ink);
    outline-offset: 3px;
  }
  #AboutHero-{{ sid }} .ah-btn__static {
    display: block;
    white-space: nowrap;
    transition: opacity 400ms var(--ease);
  }
  #AboutHero-{{ sid }} .ah-btn__track {
    position: absolute;
    top: 50%;
    left: 0;
    display: flex;
    gap: 2.5em;
    width: max-content;
    opacity: 0;
    transform: translate(0, -50%);
    white-space: nowrap;
    animation: ah-btn-marquee var(--ah-btn-speed) linear infinite;
    animation-play-state: paused;
    animation-direction: var(--ah-btn-dir);
    transition: opacity 400ms var(--ease);
    pointer-events: none;
  }
  /* Track only takes over once JS has built the seamless loop */
  #AboutHero-{{ sid }} .ah-btn[data-ready]:hover .ah-btn__static,
  #AboutHero-{{ sid }} .ah-btn[data-ready]:focus-visible .ah-btn__static {
    opacity: 0;
  }
  #AboutHero-{{ sid }} .ah-btn[data-ready]:hover .ah-btn__track,
  #AboutHero-{{ sid }} .ah-btn[data-ready]:focus-visible .ah-btn__track {
    opacity: 1;
    animation-play-state: running;
  }
  @keyframes ah-btn-marquee {
    from { transform: translate(0, -50%); }
    to { transform: translate(calc(-1 * var(--marquee-loop, 200px)), -50%); }
  }

  /* ---- Scroll cue ---- */
  #AboutHero-{{ sid }} .ah-cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    z-index: 2;
    /* Base transform keeps the cue centered when the bounce animation
       is disabled (reduced motion or animations off) */
    transform: translateX(-50%);
    color: var(--ah-muted);
  }
  #AboutHero-{{ sid }}[data-animate='true'] .ah-cue {
    animation: ah-cue-bounce 2.8s var(--ease) infinite;
  }
  #AboutHero-{{ sid }} .ah-cue__text {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  #AboutHero-{{ sid }} .ah-cue__arrow {
    display: block;
    width: 10px;
    height: 10px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
  }
  @keyframes ah-cue-bounce {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 7px); }
  }

  /* ---- Decorative illustration blocks ---- */
  #AboutHero-{{ sid }} .ah-illo {
    position: absolute;
    z-index: 0;
    width: var(--illo-size);
    opacity: var(--illo-o);
    pointer-events: none;
    /* Base transform carries the per-block parallax drift; the float
       keyframes below re-compose it so the two effects stack */
    transform: translate3d(0, var(--ah-illo-par, 0px), 0);
  }
  #AboutHero-{{ sid }} .ah-illo--above { z-index: 2; }
  #AboutHero-{{ sid }} .ah-illo img {
    width: 100%;
    height: auto;
    transform: rotate(var(--illo-rot));
  }
  /* Anchors: offsets are folded into the inset so positive X always
     moves right and positive Y always moves down */
  #AboutHero-{{ sid }} .ah-illo--top-left { top: calc(5% + var(--illo-y)); left: calc(5% + var(--illo-x)); }
  #AboutHero-{{ sid }} .ah-illo--top-right { top: calc(5% + var(--illo-y)); right: calc(5% - var(--illo-x)); }
  #AboutHero-{{ sid }} .ah-illo--beside-heading { top: calc(16% + var(--illo-y)); right: calc(14% - var(--illo-x)); }
  #AboutHero-{{ sid }} .ah-illo--left-center { top: calc(50% - var(--illo-size) / 2 + var(--illo-y)); left: calc(3% + var(--illo-x)); }
  #AboutHero-{{ sid }} .ah-illo--right-center { top: calc(50% - var(--illo-size) / 2 + var(--illo-y)); right: calc(3% - var(--illo-x)); }
  #AboutHero-{{ sid }} .ah-illo--bottom-left { bottom: calc(5% - var(--illo-y)); left: calc(5% + var(--illo-x)); }
  #AboutHero-{{ sid }} .ah-illo--bottom-right { bottom: calc(5% - var(--illo-y)); right: calc(5% - var(--illo-x)); }

  #AboutHero-{{ sid }}[data-animate='true'] .ah-illo--float {
    animation: ah-illo-float var(--illo-float, 8s) ease-in-out infinite;
  }
  @keyframes ah-illo-float {
    0%, 100% { transform: translate3d(0, var(--ah-illo-par, 0px), 0); }
    50% { transform: translate3d(0, calc(var(--ah-illo-par, 0px) - 12px), 0); }
  }

  /* ---- Load animation (one-shot).
     Implemented as CSS animations rather than a class-toggled
     transition on purpose: a keyframe animation with fill-mode "both"
     always reaches its final state on wall-clock time, even when the
     page is in a background tab or a hidden preview iframe where
     requestAnimationFrame is never serviced. The .ah-anim class is
     added by JS, so a visit without JS renders the final state and
     nothing is ever left stuck at opacity 0. ---- */
  #AboutHero-{{ sid }} .ah-w { display: inline-block; }

  #AboutHero-{{ sid }}.ah-anim .ah-w {
    animation: ah-word-in 600ms var(--ease) both;
    animation-delay: calc(var(--wi, 0) * var(--ah-stagger, 30ms));
  }
  #AboutHero-{{ sid }}.ah-anim .ah-media {
    animation: ah-media-in 700ms var(--ease) both;
    animation-delay: var(--ah-media-delay, 500ms);
  }
  #AboutHero-{{ sid }}.ah-anim .ah-label {
    animation: ah-fade-in 600ms var(--ease) both;
  }
  #AboutHero-{{ sid }}.ah-anim .ah-btnrow {
    animation: ah-fade-in 700ms var(--ease) both;
    animation-delay: calc(var(--ah-media-delay, 500ms) + 300ms);
  }
  /* The cue owns an infinite bounce, so its entrance is a delay on the
     bounce itself rather than a second animation on the same element */
  #AboutHero-{{ sid }}.ah-anim[data-animate='true'] .ah-cue {
    animation-delay: calc(var(--ah-media-delay, 500ms) + 300ms);
  }

  @keyframes ah-word-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes ah-media-in {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes ah-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* ---- Responsive ---- */
  @media (max-width: 749px) {
    #AboutHero-{{ sid }} {
      padding-top: {{ s.pad_top_m }}px;
      padding-bottom: {{ s.pad_bottom_m }}px;
    }
    #AboutHero-{{ sid }} .ah-illo { display: none; }
    #AboutHero-{{ sid }} .ah-illo--m { display: block; }
    #AboutHero-{{ sid }} .ah-cue--hide-m { display: none; }
    {% if s.stack_mobile %}
    #AboutHero-{{ sid }} .ah-media {
      display: block;
      width: min(62%, 280px);
      height: auto;
      margin: 0.45em auto;
    }
    {% endif %}
  }

  /* ---- Reduced motion: no load sweep, no parallax, no float, no
         bounce, no marquee — final state renders immediately ---- */
  @media (prefers-reduced-motion: reduce) {
    #AboutHero-{{ sid }} .ah-inner { transform: none; }
    #AboutHero-{{ sid }} .ah-illo { transform: none; }
    #AboutHero-{{ sid }} .ah-btn__track { display: none; }
    #AboutHero-{{ sid }} .ah-btn[data-ready]:hover .ah-btn__static,
    #AboutHero-{{ sid }} .ah-btn[data-ready]:focus-visible .ah-btn__static { opacity: 1; }
    /* Cancel every animation, then restore the final state explicitly:
       with the animation gone, fill-mode can no longer hold it. */
    #AboutHero-{{ sid }} *,
    #AboutHero-{{ sid }}.ah-anim .ah-w,
    #AboutHero-{{ sid }}.ah-anim .ah-media,
    #AboutHero-{{ sid }}.ah-anim .ah-label,
    #AboutHero-{{ sid }}.ah-anim .ah-btnrow,
    #AboutHero-{{ sid }}.ah-anim .ah-cue { animation: none !important; }
    #AboutHero-{{ sid }} .ah-w,
    #AboutHero-{{ sid }} .ah-label,
    #AboutHero-{{ sid }} .ah-btnrow { opacity: 1; transform: none; }
    #AboutHero-{{ sid }} .ah-media { clip-path: none; }
  }
{% endstyle %}

<div
  id="AboutHero-{{ sid }}"
  data-about-hero
  data-animate="{{ s.enable_animations }}"
  data-load-anim="{{ s.load_animation }}"
  data-parallax="{{ s.parallax_strength }}"
>
  {%- comment -%} Decorative illustrations: absolute, behind content by default {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'illustration' and block.settings.image != blank -%}
      <div
        class="ah-illo ah-illo--{{ block.settings.position }}{% if block.settings.show_mobile %} ah-illo--m{% endif %}{% if block.settings.float %} ah-illo--float{% endif %}{% if block.settings.above %} ah-illo--above{% endif %}"
        style="--illo-size: {{ block.settings.size }}px; --illo-x: {{ block.settings.offset_x }}px; --illo-y: {{ block.settings.offset_y }}px; --illo-rot: {{ block.settings.rotation }}deg; --illo-o: {{ block.settings.opacity | divided_by: 100.0 }}; --illo-float: {{ block.settings.float_speed }}s;"
        data-illo
        data-illo-parallax="{{ block.settings.parallax }}"
        aria-hidden="true"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.image | image_url: width: 560 | image_tag: loading: 'lazy', alt: '', widths: '280, 560', sizes: '280px' }}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="ah-inner" data-inner>
    {%- if s.show_label and s.label_text != blank -%}
      <span class="ah-label">{{ s.label_text | escape }}</span>
    {%- endif -%}

    {%- if s.text_before != blank or s.text_after != blank -%}
      <{{ s.heading_tag }} class="ah-statement" aria-label="{{ plain_label | escape }}">
        <span aria-hidden="true" data-flow>
          {%- if s.text_before != blank -%}
            <span class="ah-seg" data-split>{{ before_html }}</span>
          {%- endif -%}
          {%- comment -%}
            The inline image is rendered only when the merchant has
            actually chosen one. With no image the two richtext
            segments close up and the statement reads as one
            uninterrupted sentence — no placeholder block is drawn.
          {%- endcomment -%}
          {%- if s.image != blank -%}
            <span class="ah-media" style="--ah-img-ar: {{ s.image.aspect_ratio }}" data-media>
              {{- s.image | image_url: width: 900 | image_tag: loading: 'eager', alt: '', widths: '450, 900', sizes: '300px' -}}
            </span>
          {%- endif -%}
          {%- if s.text_after != blank -%}
            <span class="ah-seg" data-split>{{ after_html }}</span>
          {%- endif -%}
        </span>
      </{{ s.heading_tag }}>
    {%- endif -%}

    {%- if s.show_button and s.button_label != blank -%}
      <div class="ah-btnrow">
        <a class="ah-btn" href="{{ s.button_link | default: '#' }}" data-marquee>
          <span class="ah-btn__static">{{ s.button_label | escape }}</span>
          <span class="ah-btn__track" aria-hidden="true" data-marquee-track>
            <span data-marquee-copy>{{ s.button_label | escape }}</span>
          </span>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if s.show_cue -%}
    <div class="ah-cue{% unless s.cue_mobile %} ah-cue--hide-m{% endunless %}" aria-hidden="true">
      {%- if s.cue_style == 'text' -%}
        <span class="ah-cue__text">{{ s.cue_text | escape }}</span>
      {%- else -%}
        <span class="ah-cue__arrow"></span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    'use strict';

    /* Wrap each word in a positioned span (preserving <em>/<strong>),
       skipping whitespace so no empty spans are ever produced.
       Returns the running word index for cross-segment stagger. */
    function splitWords(container, startIndex) {
      var idx = startIndex;
      function walk(node) {
        var child = node.firstChild;
        while (child) {
          var next = child.nextSibling;
          if (child.nodeType === 3) {
            if (child.nodeValue.trim() !== '') {
              var frag = document.createDocumentFragment();
              var parts = child.nodeValue.split(/(\s+)/);
              for (var i = 0; i < parts.length; i++) {
                if (parts[i] === '') continue;
                if (/^\s+$/.test(parts[i])) {
                  frag.appendChild(document.createTextNode(parts[i]));
                } else {
                  var w = document.createElement('span');
                  w.className = 'ah-w';
                  w.style.setProperty('--wi', idx++);
                  w.textContent = parts[i];
                  frag.appendChild(w);
                }
              }
              node.replaceChild(frag, child);
            }
          } else if (child.nodeType === 1) {
            walk(child);
          }
          child = next;
        }
      }
      walk(container);
      return idx;
    }

    /* Shared marquee-button builder: measures one label copy, appends
       enough clones to cover the pill plus one loop unit, and exposes
       the loop distance so any label length loops invisibly. */
    function buildMarquee(btn) {
      if (!btn) return null;
      var track = btn.querySelector('[data-marquee-track]');
      var copy = btn.querySelector('[data-marquee-copy]');
      if (!track || !copy) return null;
      function build() {
        var clones = track.querySelectorAll('[data-clone]');
        for (var i = 0; i < clones.length; i++) track.removeChild(clones[i]);
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        var unit = copy.getBoundingClientRect().width + gap;
        if (unit <= gap) return;
        var needed = Math.ceil((btn.clientWidth + unit) / unit) + 1;
        for (var j = 0; j < needed; j++) {
          var c = copy.cloneNode(true);
          c.setAttribute('data-clone', '');
          track.appendChild(c);
        }
        btn.style.setProperty('--marquee-loop', unit + 'px');
        btn.setAttribute('data-ready', '');
      }
      build();
      return build;
    }

    function initAboutHero(root) {
      /* The guard lives on the element object, never as a data-
         attribute: an attribute is serialized into innerHTML, so a
         theme or app that re-injects cached markup would ship an
         already-"initialized" section that never wires itself up and
         stays stuck in its pre-animation state. */
      if (!root || root.__ahInit) return;
      root.__ahInit = true;

      var prm = window.matchMedia('(prefers-reduced-motion: reduce)');
      var animOn = root.dataset.animate === 'true';
      var inner = root.querySelector('[data-inner]');
      var segs = root.querySelectorAll('[data-split]');
      var illos = Array.prototype.slice.call(root.querySelectorAll('[data-illo]'));

      /* Clear any progress values left behind by a previous life of
         this markup (see the guard note above) */
      root.classList.remove('ah-anim');
      if (inner) inner.style.removeProperty('--ah-drift');

      /* ---- Load animation (one-shot), driven entirely by CSS
         keyframes with fill-mode "both" so the final state is reached
         on wall-clock time even if no frame is ever painted. ---- */
      if (animOn && root.dataset.loadAnim === 'true' && !prm.matches && segs.length) {
        var count = 0;
        for (var i = 0; i < segs.length; i++) count = splitWords(segs[i], count);
        if (count > 0) {
          /* Stagger shrinks with word count so the sweep stays < 1.2s */
          var stagger = Math.min(32, Math.max(12, Math.round(820 / count)));
          root.style.setProperty('--ah-stagger', stagger + 'ms');
          root.style.setProperty('--ah-media-delay', Math.min(900, count * stagger + 220) + 'ms');
          root.classList.add('ah-anim');
        }
      }

      /* ---- Marquee button ---- */
      var rebuildMarquee = buildMarquee(root.querySelector('[data-marquee]'));

      /* ---- Scroll parallax (linked + reversible). Measurements are
         cached outside the frame loop; the loop reads scrollY only. ---- */
      var kStatement = (parseFloat(root.dataset.parallax) || 0) / 100 * 0.35;
      var illoData = illos.map(function (el) {
        return { el: el, k: (parseFloat(el.dataset.illoParallax) || 0) / 100 * 0.45 };
      });
      var hasParallax = animOn && (kStatement > 0 || illoData.some(function (d) { return d.k > 0; }));
      var vh = 1;
      var secTop = 0;
      var secH = 0;
      var ticking = false;

      function measure() {
        vh = window.innerHeight || 1;
        secTop = root.getBoundingClientRect().top + window.scrollY;
        secH = root.offsetHeight;
      }

      function frame() {
        ticking = false;
        var sc = window.scrollY - secTop;
        if (sc < 0) sc = 0;
        var max = secH * 1.5;
        if (sc > max) sc = max;
        if (inner) inner.style.setProperty('--ah-drift', (sc * kStatement).toFixed(1) + 'px');
        for (var i = 0; i < illoData.length; i++) {
          if (illoData[i].k > 0) {
            illoData[i].el.style.setProperty('--ah-illo-par', (-sc * illoData[i].k).toFixed(1) + 'px');
          }
        }
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(frame);
        }
      }

      var resizeTimer = null;
      function onResize() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
          measure();
          if (rebuildMarquee) rebuildMarquee();
          onScroll();
        }, 150);
      }

      function stopParallax() {
        window.removeEventListener('scroll', onScroll);
        if (inner) inner.style.removeProperty('--ah-drift');
        illoData.forEach(function (d) { d.el.style.removeProperty('--ah-illo-par'); });
      }

      if (hasParallax && !prm.matches) {
        measure();
        frame();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
      window.addEventListener('resize', onResize);
      /* Re-measure once everything has loaded. When the section is
         inserted after page load (theme editor), "load" will never
         fire again, so fall back to a deferred re-measure. */
      if (document.readyState === 'complete') {
        setTimeout(function () { measure(); onScroll(); }, 0);
      } else {
        window.addEventListener('load', function () { measure(); onScroll(); }, { once: true });
      }

      function onMotionChange() {
        if (prm.matches) {
          stopParallax();
          root.classList.remove('ah-anim');
        }
      }
      if (prm.addEventListener) prm.addEventListener('change', onMotionChange);

      root.__teardown = function () {
        stopParallax();
        window.removeEventListener('resize', onResize);
        if (prm.removeEventListener) prm.removeEventListener('change', onMotionChange);
      };
    }

    /* Theme-editor lifecycle: one delegated listener per section type;
       each instance initializes itself by id, so instances never clash */
    if (!window.__aboutHeroReady) {
      window.__aboutHeroReady = true;
      document.addEventListener('shopify:section:load', function (event) {
        var el = event.target.querySelector('[data-about-hero]');
        if (el) initAboutHero(el);
      });
      document.addEventListener('shopify:section:unload', function (event) {
        var el = event.target.querySelector('[data-about-hero]');
        if (el && el.__teardown) el.__teardown();
      });
    }
    initAboutHero(document.getElementById('AboutHero-{{ sid }}'));
  })();
</script>

