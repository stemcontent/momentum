{% comment %}
  ------------------------------------------------------------------
  About bento — Cleopatra Closet
  ------------------------------------------------------------------
  A six-tile bento "About us" block. Every string, image, colour,
  toggle and animation value is a theme-editor setting; nothing in
  this file needs to be edited to change the content.

  Structure
    sections/about-bento.liquid  markup + schema  (this file)
    assets/about-bento.css       all layout / motion styling
    assets/about-bento.js        observers, parallax fallback, ticker

  Notes for future maintainers
    - DOM order is the mobile reading order: story, hero, quote,
      arch, stats, ticker. Desktop and tablet re-order visually with
      grid-template-areas, which are emitted below as the custom
      properties --ab-areas-d / --ab-areas-t so the stylesheet stays
      free of merchant-driven values.
    - Hiding tiles: all six visible and any single-tile-hidden case
      gets a hand-built, gap-free template. Two or more hidden falls
      back to a two-column auto flow (.ab--flow) where wide tiles
      span both columns, which is also gap-free.
    - The only inline CSS is the token block below (settings ->
      custom properties, plus the @font-face rules Shopify requires
      to be inlined).
  ------------------------------------------------------------------
{% endcomment %}

{%- comment -%}
  A literal newline, used to split the heading textarea into lines.
  It has to live in its own assign tag: the line-based {% liquid %}
  form below cannot hold a string that spans two lines.
{%- endcomment -%}
{%- assign nl = '
' -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id

  assign metrics = section.blocks | where: 'type', 'metric'
  assign ticker_items = section.blocks | where: 'type', 'ticker_item'

  comment
    A tile only renders when its toggle is on AND it has something to
    show. Empty stats / ticker tiles would otherwise leave a coloured
    void in the grid.
  endcomment
  assign show_story = s.show_story
  assign show_hero = s.show_hero
  assign show_quote = s.show_quote
  assign show_arch = s.show_arch
  assign show_stats = s.show_stats
  assign show_ticker = s.show_ticker
  if metrics.size == 0
    assign show_stats = false
  endif
  if ticker_items.size == 0
    assign show_ticker = false
  endif

  assign hidden_count = 0
  assign hidden_key = ''
  unless show_story
    assign hidden_count = hidden_count | plus: 1
    assign hidden_key = 'story'
  endunless
  unless show_hero
    assign hidden_count = hidden_count | plus: 1
    assign hidden_key = 'hero'
  endunless
  unless show_quote
    assign hidden_count = hidden_count | plus: 1
    assign hidden_key = 'quote'
  endunless
  unless show_arch
    assign hidden_count = hidden_count | plus: 1
    assign hidden_key = 'arch'
  endunless
  unless show_stats
    assign hidden_count = hidden_count | plus: 1
    assign hidden_key = 'stats'
  endunless
  unless show_ticker
    assign hidden_count = hidden_count | plus: 1
    assign hidden_key = 'ticker'
  endunless

  assign visible_count = 6 | minus: hidden_count
-%}

{%- if visible_count > 0 -%}

  {%- liquid
    comment
      ---- grid-template-areas -------------------------------------
      Emitted as custom properties. Desktop = 6 columns, tablet = 4.
      Every template below fills every cell of every row, so there is
      never an empty cell or an orphan row.
    endcomment
    assign flow = false

    if hidden_count == 0
      capture areas_d
        echo '"story story story story hero hero" "story story story story hero hero" "arch arch quote quote hero hero" "arch arch ticker ticker stats stats"'
      endcapture
      capture areas_t
        echo '"story story story story" "arch arch hero hero" "quote quote hero hero" "stats stats hero hero" "ticker ticker ticker ticker"'
      endcapture

    elsif hidden_count == 1
      case hidden_key
        when 'story'
          capture areas_d
            echo '"hero hero hero arch arch arch" "hero hero hero arch arch arch" "hero hero hero quote quote quote" "ticker ticker ticker stats stats stats"'
          endcapture
          capture areas_t
            echo '"arch arch hero hero" "quote quote hero hero" "stats stats hero hero" "ticker ticker ticker ticker"'
          endcapture
        when 'hero'
          capture areas_d
            echo '"story story story story story story" "story story story story story story" "arch arch arch quote quote quote" "arch arch arch stats stats stats" "ticker ticker ticker ticker ticker ticker"'
          endcapture
          capture areas_t
            echo '"story story story story" "arch arch quote quote" "stats stats stats stats" "ticker ticker ticker ticker"'
          endcapture
        when 'quote'
          capture areas_d
            echo '"story story story story hero hero" "story story story story hero hero" "arch arch arch arch hero hero" "ticker ticker ticker stats stats stats"'
          endcapture
          capture areas_t
            echo '"story story story story" "arch arch hero hero" "stats stats hero hero" "ticker ticker ticker ticker"'
          endcapture
        when 'arch'
          capture areas_d
            echo '"story story story story hero hero" "story story story story hero hero" "quote quote quote quote hero hero" "ticker ticker stats stats hero hero"'
          endcapture
          capture areas_t
            echo '"story story story story" "quote quote hero hero" "stats stats hero hero" "ticker ticker ticker ticker"'
          endcapture
        when 'stats'
          capture areas_d
            echo '"story story story story hero hero" "story story story story hero hero" "arch arch quote quote hero hero" "arch arch ticker ticker ticker ticker"'
          endcapture
          capture areas_t
            echo '"story story story story" "arch arch hero hero" "quote quote hero hero" "ticker ticker ticker ticker"'
          endcapture
        when 'ticker'
          capture areas_d
            echo '"story story story story hero hero" "story story story story hero hero" "arch arch quote quote hero hero" "arch arch stats stats hero hero"'
          endcapture
          capture areas_t
            echo '"story story story story" "arch arch hero hero" "quote quote hero hero" "stats stats hero hero"'
          endcapture
      endcase

    else
      comment
        Two or more tiles hidden: two-column auto flow. story and
        ticker always span both columns; if the number of remaining
        half-width tiles is odd, the last one is widened so the final
        row is never half empty.
      endcomment
      assign flow = true
      assign half = 0
      if show_hero
        assign half = half | plus: 1
        assign last_half = 'hero'
      endif
      if show_quote
        assign half = half | plus: 1
        assign last_half = 'quote'
      endif
      if show_arch
        assign half = half | plus: 1
        assign last_half = 'arch'
      endif
      if show_stats
        assign half = half | plus: 1
        assign last_half = 'stats'
      endif
      assign half_mod = half | modulo: 2
      unless half_mod == 1
        assign last_half = ''
      endunless
    endif

    comment
      ---- aspect ratios ----------------------------------
    endcomment
    case s.hero_ratio
      when 'r45'
        assign hero_ratio = '4 / 5'
      when 'r23'
        assign hero_ratio = '2 / 3'
      when 'fill'
        assign hero_ratio = '3 / 4'
      else
        assign hero_ratio = '3 / 4'
    endcase
    case s.arch_ratio
      when 'r45'
        assign arch_ratio = '4 / 5'
      when 'r23'
        assign arch_ratio = '2 / 3'
      when 'r11'
        assign arch_ratio = '1 / 1'
      else
        assign arch_ratio = '4 / 3'
    endcase

    comment
      ---- ticker separator -------------------------------
    endcomment
    case s.ticker_separator
      when 'dot'
        assign sep = '•'
      when 'slash'
        assign sep = '/'
      when 'star'
        assign sep = '✦'
      when 'none'
        assign sep = ''
      else
        assign sep = '◆'
    endcase

    comment
      ---- animation switches -----------------------------
    endcomment
    assign anim = s.anim_enable
    assign par_d = s.parallax_desktop
    assign par_m = s.parallax_mobile
    assign mods = ''
    unless anim
      assign par_d = 0
      assign par_m = 0
      assign mods = 'ab--noanim ab--no-reveal ab--no-head ab--no-zoom ab--no-tick ab--no-hover'
    else
      unless s.anim_reveal
        assign mods = mods | append: ' ab--no-reveal'
      endunless
      unless s.anim_heading
        assign mods = mods | append: ' ab--no-head'
      endunless
      unless s.anim_zoom
        assign mods = mods | append: ' ab--no-zoom'
      endunless
      unless s.anim_ticker
        assign mods = mods | append: ' ab--no-tick'
      endunless
      unless s.anim_hover
        assign mods = mods | append: ' ab--no-hover'
      endunless
    endunless
    if flow
      assign mods = mods | append: ' ab--flow'
    endif
    if par_d == 0
      assign mods = mods | append: ' ab--par0-d'
    endif
    if par_m == 0
      assign mods = mods | append: ' ab--par0-m'
    endif

    comment
      ---- metric column counts ----------------------------
    endcomment
    assign metric_cols = metrics.size
    assign metric_cols_m = metrics.size
    if metrics.size > 3
      assign metric_cols_m = 2
    endif

    comment
      ---- responsive image widths --------------------------
    endcomment
    assign widths = '400,600,800,1200,1600,2000' | split: ','
    assign media_sizes = '(min-width: 1024px) min(34vw, 520px), (min-width: 768px) calc(50vw - 38px), calc(100vw - 40px)'

    comment
      ---- reveal stagger index ------------------------------
    endcomment
    assign idx = 0
  -%}

  {{ 'about-bento.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    {{ s.heading_font | font_face: font_display: 'swap' }}
    {{ s.body_font | font_face: font_display: 'swap' }}
    {%- assign heading_italic = s.heading_font | font_modify: 'style', 'italic' -%}
    {%- if heading_italic -%}{{ heading_italic | font_face: font_display: 'swap' }}{%- endif -%}
    {%- assign body_bold = s.body_font | font_modify: 'weight', 'bolder' -%}
    {%- if body_bold -%}{{ body_bold | font_face: font_display: 'swap' }}{%- endif -%}

    #ab-{{ sid }} {
      --ab-page-bg: {{ s.color_page_bg }};
      --ab-light-bg: {{ s.color_light_bg }};
      --ab-dark-bg: {{ s.color_dark_bg }};
      --ab-accent-bg: {{ s.color_accent_bg }};
      --ab-dark-text: {{ s.color_dark_text }};
      --ab-light-text: {{ s.color_light_text }};
      --ab-accent-text: {{ s.color_accent_text }};
      --ab-tint: {{ s.color_tint }};
      --ab-quote-bg: {{ s.quote_bg }};
      --ab-hairline: {{ s.color_dark_text | color_modify: 'alpha', 0.22 }};
      --ab-soft: {{ s.color_dark_text | color_modify: 'alpha', 0.1 }};

      --ab-maxw: {{ s.content_width }}px;
      --ab-gap: {{ s.tile_gap }}px;
      --ab-radius: {{ s.corner_radius }}px;
      --ab-pad-top-d: {{ s.space_above_desktop }}px;
      --ab-pad-bot-d: {{ s.space_below_desktop }}px;
      --ab-pad-top-m: {{ s.space_above_mobile }}px;
      --ab-pad-bot-m: {{ s.space_below_mobile }}px;

      --ab-heading-font: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
      --ab-body-font: {{ s.body_font.family }}, {{ s.body_font.fallback_families }};
      --ab-heading-weight: {{ s.heading_font.weight }};
      --ab-h-size-d: {{ s.heading_size_desktop }}px;
      --ab-h-size-m: {{ s.heading_size_mobile | at_least: 30 }}px;
      --ab-body-size: {{ s.body_size }}px;

      --ab-hero-ratio: {{ hero_ratio }};
      --ab-arch-ratio: {{ arch_ratio }};
      --ab-overlay: {% if s.hero_overlay %}{{ s.hero_overlay_opacity | divided_by: 100.0 }}{% else %}0{% endif %};

      --ab-metric-cols: {{ metric_cols }};
      --ab-metric-cols-m: {{ metric_cols_m }};
      --ab-ticker-dur: {{ s.ticker_speed }}s;

      --ab-stagger: {{ s.reveal_stagger }}ms;
      --ab-par-d: {{ par_d }}px;
      --ab-par-m: {{ par_m }}px;

      --ab-areas-d: {{ areas_d }};
      --ab-areas-t: {{ areas_t }};
    }
  {%- endstyle -%}

  <section
    class="ab {{ mods | strip }}"
    id="ab-{{ sid }}"
    data-ab-root
    data-ab-anim="{% if anim %}on{% else %}off{% endif %}"
    data-ab-count="{% if anim and s.anim_count %}on{% else %}off{% endif %}"
    {% if s.aria_label != blank %}aria-label="{{ s.aria_label | escape }}"{% endif %}
  >
    <div class="ab-inner">
      <div class="ab-grid">

        {%- comment -%} ---------------- 1. Story ---------------- {%- endcomment -%}
        {%- if show_story -%}
          <div class="ab-tile ab-story" style="--i: {{ idx }};">
            {%- assign idx = idx | plus: 1 -%}

            {%- if s.eyebrow != blank -%}
              <p class="ab-eyebrow">
                {%- if s.show_eyebrow_rule -%}<span class="ab-rule" aria-hidden="true"></span>{%- endif -%}
                <span>{{ s.eyebrow | escape }}</span>
              </p>
            {%- endif -%}

            {%- if s.heading != blank -%}
              {%- liquid
                assign heading_lines = s.heading | strip | split: nl
                assign accent = s.accent_word | strip | downcase
                assign accent_size = accent | size
                assign accent_done = false
                assign line_i = 0
              -%}
              <h2 class="ab-heading">
                {%- for raw_line in heading_lines -%}
                  {%- assign line = raw_line | strip -%}
                  {%- if line == blank -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign markup = line | escape
                    if accent_size > 0 and accent_done == false
                      assign lower = line | downcase
                      if lower contains accent
                        assign parts = lower | split: accent
                        assign before_len = 0
                        if parts.size > 0
                          assign before_len = parts[0] | size
                        endif
                        assign after_start = before_len | plus: accent_size
                        assign after_len = line | size | minus: after_start
                        assign before = ''
                        if before_len > 0
                          assign before = line | slice: 0, before_len
                        endif
                        assign word = line | slice: before_len, accent_size
                        assign after = ''
                        if after_len > 0
                          assign after = line | slice: after_start, after_len
                        endif
                        capture markup
                          echo before | escape
                          echo '<em class="ab-accent">'
                          echo word | escape
                          echo '</em>'
                          echo after | escape
                        endcapture
                        assign accent_done = true
                      endif
                    endif
                  -%}
                  <span class="ab-line"><span class="ab-line-i" style="--l: {{ line_i }};">{{ markup }}</span></span>
                  {%- assign line_i = line_i | plus: 1 -%}
                {%- endfor -%}
              </h2>
            {%- endif -%}

            {%- if s.body != blank -%}
              <div class="ab-body rte">{{ s.body }}</div>
            {%- endif -%}

            {%- if s.tags != blank -%}
              <ul class="ab-tags">
                {%- assign tag_list = s.tags | split: ',' -%}
                {%- for tag in tag_list -%}
                  {%- assign tag_text = tag | strip -%}
                  {%- if tag_text != blank -%}
                    <li class="ab-tag">{{ tag_text | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if s.button_label != blank -%}
              {%- comment -%}
                Until the merchant picks a link this renders as a span, not
                an anchor, so a fresh install never ships a dead href="#".
              {%- endcomment -%}
              {%- capture button_inner -%}
                <span>{{ s.button_label | escape }}</span>
                {%- if s.button_style == 'link' -%}
                  <svg class="ab-arrow" viewBox="0 0 20 12" width="20" height="12" fill="none" aria-hidden="true" focusable="false">
                    <path d="M0 6h18M13 1l5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              {%- endcapture -%}
              {%- if s.button_link != blank -%}
                <a class="ab-btn ab-btn--{{ s.button_style }}" href="{{ s.button_link }}">{{ button_inner }}</a>
              {%- else -%}
                <span class="ab-btn ab-btn--{{ s.button_style }}">{{ button_inner }}</span>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} ---------------- 2. Hero ----------------- {%- endcomment -%}
        {%- if show_hero -%}
          {%- liquid
            assign hero_img = s.hero_image
            assign hero_alt = ''
            if hero_img != blank and hero_img.alt != blank
              assign hero_alt = hero_img.alt
            elsif s.hero_alt != blank
              assign hero_alt = s.hero_alt
            endif
          -%}
          <div
            class="ab-tile ab-hero{% if s.hero_ratio == 'fill' %} ab-hero--fill{% endif %}{% if last_half == 'hero' %} ab-tile--wide{% endif %}"
            style="--i: {{ idx }};"
          >
            {%- assign idx = idx | plus: 1 -%}
            <div class="ab-media ab-media--hero">
              <div class="ab-media-inner" data-ab-par>
                {%- if hero_img != blank -%}
                  <img
                    src="{{ hero_img | image_url: width: 1200 }}"
                    srcset="{% for w in widths %}{% assign wn = w | times: 1 %}{% if hero_img.width >= wn %}{{ hero_img | image_url: width: wn }} {{ wn }}w, {% endif %}{% endfor %}{{ hero_img | image_url: width: hero_img.width }} {{ hero_img.width }}w"
                    sizes="{{ media_sizes }}"
                    width="{{ hero_img.width }}"
                    height="{{ hero_img.height }}"
                    alt="{{ hero_alt | escape }}"
                    {% if s.section_at_top %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    decoding="async"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'ab-placeholder' }}
                {%- endif -%}
              </div>
              {%- if s.hero_overlay -%}<span class="ab-overlay" aria-hidden="true"></span>{%- endif -%}
              {%- if s.hero_caption != blank -%}
                <p class="ab-caption">{{ s.hero_caption | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ---------------- 3. Quote ---------------- {%- endcomment -%}
        {%- if show_quote -%}
          <div class="ab-tile ab-quote{% if last_half == 'quote' %} ab-tile--wide{% endif %}" style="--i: {{ idx }};">
            {%- assign idx = idx | plus: 1 -%}
            {%- if s.quote_mark -%}
              <span class="ab-qmark" aria-hidden="true">&ldquo;</span>
            {%- endif -%}
            <blockquote class="ab-blockquote">
              {%- if s.quote_text != blank -%}
                <p>{{ s.quote_text | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if s.quote_author != blank -%}
                <cite class="ab-cite">{{ s.quote_author | escape }}</cite>
              {%- endif -%}
            </blockquote>
          </div>
        {%- endif -%}

        {%- comment -%} ---------------- 4. Arch ----------------- {%- endcomment -%}
        {%- if show_arch -%}
          {%- liquid
            assign arch_img = s.arch_image
            assign arch_alt = ''
            if arch_img != blank and arch_img.alt != blank
              assign arch_alt = arch_img.alt
            elsif s.arch_alt != blank
              assign arch_alt = s.arch_alt
            endif
          -%}
          <div
            class="ab-tile ab-arch{% if s.arch_tint %} ab-arch--tint{% endif %}{% if last_half == 'arch' %} ab-tile--wide{% endif %}"
            style="--i: {{ idx }};"
          >
            {%- assign idx = idx | plus: 1 -%}
            <div class="ab-media ab-media--arch">
              <div class="ab-media-inner" data-ab-par>
                {%- if arch_img != blank -%}
                  <img
                    src="{{ arch_img | image_url: width: 1200 }}"
                    srcset="{% for w in widths %}{% assign wn = w | times: 1 %}{% if arch_img.width >= wn %}{{ arch_img | image_url: width: wn }} {{ wn }}w, {% endif %}{% endfor %}{{ arch_img | image_url: width: arch_img.width }} {{ arch_img.width }}w"
                    sizes="{{ media_sizes }}"
                    width="{{ arch_img.width }}"
                    height="{{ arch_img.height }}"
                    alt="{{ arch_alt | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'ab-placeholder' }}
                {%- endif -%}
              </div>
              {%- if s.arch_tint -%}<span class="ab-tint" aria-hidden="true"></span>{%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ---------------- 5. Stats ---------------- {%- endcomment -%}
        {%- if show_stats -%}
          <div class="ab-tile ab-stats{% if last_half == 'stats' %} ab-tile--wide{% endif %}" style="--i: {{ idx }};">
            {%- assign idx = idx | plus: 1 -%}
            <ul class="ab-metrics">
              {%- for block in metrics limit: 4 -%}
                {%- assign val = block.settings.value | strip -%}
                <li class="ab-metric" {{ block.shopify_attributes }}>
                  <p class="ab-metric-num">
                    <span
                      class="ab-metric-val"
                      data-ab-metric
                      data-ab-value="{{ val | escape }}"
                    >{{ val }}</span
                    >{%- if block.settings.suffix != blank -%}<span class="ab-metric-suffix">{{ block.settings.suffix | escape }}</span>{%- endif -%}
                  </p>
                  {%- if block.settings.label != blank -%}
                    <p class="ab-metric-label">{{ block.settings.label | escape }}</p>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} ---------------- 6. Ticker --------------- {%- endcomment -%}
        {%- if show_ticker -%}
          <div
            class="ab-tile ab-ticker ab-ticker--{{ s.ticker_direction }}{% if s.ticker_pause_hover %} ab-ticker--hoverpause{% endif %}"
            style="--i: {{ idx }};"
            data-ab-ticker
          >
            {%- assign idx = idx | plus: 1 -%}
            <div class="ab-ticker-vp">
              <div class="ab-ticker-track">
                {%- capture ticker_list -%}
                  {%- for block in ticker_items limit: 16 -%}
                    <li class="ab-ticker-item">
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if sep != blank -%}<span class="ab-ticker-sep" aria-hidden="true">{{ sep }}</span>{%- endif -%}
                    </li>
                  {%- endfor -%}
                {%- endcapture -%}
                <ul class="ab-ticker-list">
                  {%- for block in ticker_items limit: 16 -%}
                    <li class="ab-ticker-item" {{ block.shopify_attributes }}>
                      <span>{{ block.settings.text | escape }}</span>
                      {%- if sep != blank -%}<span class="ab-ticker-sep" aria-hidden="true">{{ sep }}</span>{%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                <ul class="ab-ticker-list" aria-hidden="true">{{ ticker_list }}</ul>
              </div>
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </section>

  <script src="{{ 'about-bento.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "About bento",
  "tag": "section",
  "class": "ab-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "checkbox",
      "id": "section_at_top",
      "label": "This section is at the top of the page",
      "default": false,
      "info": "Turn on only if this is the first thing shoppers see. It loads the tall photo immediately instead of waiting, which makes the top of the page appear faster."
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Maximum width of the section",
      "min": 1100,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1440,
      "info": "How wide the tiles are allowed to grow on large screens."
    },
    {
      "type": "range",
      "id": "tile_gap",
      "label": "Space between tiles",
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12,
      "info": "Applies on tablet and desktop. Phones always use a compact 10px gap."
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner roundness",
      "min": 0,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14,
      "info": "0 gives sharp square corners."
    },
    {
      "type": "range",
      "id": "space_above_desktop",
      "label": "Space above section on computers",
      "min": 0,
      "max": 160,
