    "mission_cards": {
      "type": "mission-cards",
      "blocks": {
        "card_materials": {
          "type": "card",
          "settings": {
            "title": "Material honesty",
            "body": "<p>We start with what a thing is made of. If a material cannot age gracefully, it does not get through the door.</p>"
          }
        },
        "card_keep": {
          "type": "card",
          "settings": {
            "title": "Made to keep",
            "body": "<p>Trends have a shelf life. Our pieces are drawn slowly, tested in real homes, and meant to be handed down.</p>"
          }
        },
        "card_useful": {
          "type": "card",
          "settings": {
            "title": "Quietly useful",
            "body": "<p>The best objects do not ask for attention. They simply make the everyday feel a little more considered.</p>"
          }
        }
      },
      "block_order": ["card_materials", "card_keep", "card_useful"],
      "settings": {
        "show_label": true,
        "label_text": "OUR MISSION",
        "heading": "Why we make things",
        "align": "left",
        "show_numbers": true,
        "columns": 3,
        "offset": 30,
        "heading_tag": "h2",
        "color_bg": "#FAF3E7",
        "color_heading": "#2B1A12",
        "color_label": "#8A7566",
        "color_hairline": "#E3D7C3",
        "enable_animations": true
      }
    },
    "vision_band": {
      "type": "vision-band",
      "blocks": {
        "row_fewer": {
          "type": "row",
          "settings": {
            "label": "01",
            "title": "Fewer, better things",
            "body": "<p>We would rather perfect one object than launch ten. Our catalogue grows by subtraction as much as by addition.</p>"
          }
        },
        "row_craft": {
          "type": "row",
          "settings": {
            "label": "02",
            "title": "Craft that lasts",
            "body": "<p>We are building long relationships with small workshops, so the hands that make our pieces are the same hands year after year.</p>"
          }
        },
        "row_calm": {
          "type": "row",
          "settings": {
            "label": "03",
            "title": "A calmer home",
            "body": "<p>Everything we design should lower the volume of a room. That is the measure we hold every new idea against.</p>"
          }
        }
      },
      "block_order": ["row_fewer", "row_craft", "row_calm"],
      "settings": {
        "show_label": true,
        "label_text": "OUR VISION",
        "heading": "Where this is going",
        "align": "left",
        "row_grid": "balanced",
        "edge_style": "straight",
        "heading_tag": "h2",
