    "faq": {
      "type": "faq-accordion",
      "blocks": {
        "q_made": {
          "type": "question",
          "settings": {
            "question": "Where are your pieces made?",
            "answer": "<p>In small family-run workshops we visit often. Each product page names its workshop and region.</p>"
          }
        },
        "q_materials": {
          "type": "question",
          "settings": {
            "question": "What materials do you use?",
            "answer": "<p>Natural, honest ones — solid wood, stoneware, linen and full-grain leather — chosen to age beautifully rather than simply arrive new.</p>"
          }
        },
        "q_care": {
          "type": "question",
          "settings": {
            "question": "How do I care for my pieces?",
            "answer": "<p>Gently and rarely. Each order includes a short care card, and the same guidance lives on every product page.</p>"
          }
        },
        "q_shipping": {
          "type": "question",
          "settings": {
            "question": "What is your shipping and returns policy?",
            "answer": "<p>We ship worldwide in plastic-free packaging. If a piece is not right, you have 30 days to return it in its original condition.</p>"
          }
        },
        "q_wholesale": {
          "type": "question",
          "settings": {
            "question": "Do you work with stores or designers?",
            "answer": "<p>We do, selectively. Write to us through the contact page and tell us about your space — we read everything ourselves.</p>"
          }
        }
      },
      "block_order": ["q_made", "q_materials", "q_care", "q_shipping", "q_wholesale"],
